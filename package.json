{
  "name": "n8n-nodes-kalyvox",
  "version": "0.1.0",
  "description": "Official n8n community node for Kalyvox, the AI phone receptionist for small businesses.",
  "license": "MIT",
  "homepage": "https://kalyvox.ai/en/",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "kalyvox",
    "ai-receptionist",
    "voice-ai",
    "telephony",
    "automation",
    "customer-service"
  ],
  "author": {
    "name": "KALYVOX SASU",
    "email": "app@kalyvox.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbo-git/n8n-nodes-kalyvox.git"
  },
  "bugs": {
    "url": "https://github.com/alexbo-git/n8n-nodes-kalyvox/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/KalyvoxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Kalyvox/Kalyvox.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.26.2",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
